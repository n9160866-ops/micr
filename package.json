{
  "name": "hw-panel-electron",
  "version": "1.0.0",
  "description": "Monitoring temps réel : températures CPU/GPU par core et vitesses des ventilateurs",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.hwpanel",
    "productName": "HW Panel",
    "win": {
      "target": "portable"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper/publish",
        "to": "helper",
        "filter": ["**/*"]
      }
    ]
  }
}
